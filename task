#!/usr/bin/env bash

declare -A EXTRA_HOST_ARGS
EXTRA_HOST_ARGS[server]="--sudo --build-host server --target-host server"

function help() {
  echo "Usage: $0 [command] [options]"
  echo "Commands:"
  echo "  switch                  - Run nixos-rebuild switch"
  echo "  test                    - Run nixos-rebuild test"
  echo "  update                  - Update flake inputs and run nixos-rebuild switch"
  echo "  hardware                - Generate hardware configuration for the specified host"
  echo "  clean-garbage           - Clean up old generations and garbage"
  echo "  clean-store             - Clean up Nix store"
  echo "  clean                   - Clean up old generations, garbage, and Nix store"
  echo "Options:"
  echo "  -h, --host <hostname>   - Specify the target host (default: current host)"
  exit 1
}

# Check if the command is provided
if [[ $# -lt 1 ]]; then
  echo "Error: No command provided."
  help
fi

command="$1"
shift
host=""
# Parse command line arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--host)
      host="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done


function command_log() {
  local command="$1"
  echo -e "Running command: \e[1;32m$command\e[0m"
}

function get_cores() {
  local threads=$(nproc)
  local ram_gb=$(awk '/MemTotal/ { printf "%d", $2 / 1024 / 1024 }' /proc/meminfo)
  local ram_limit=$((ram_gb / 2))
  local cpu_limit=$((threads * 9 / 10))
  local cores=$((ram_limit < cpu_limit ? ram_limit : cpu_limit))
  cores=$((cores < 2 ? 2 : cores))
  echo "$cores"
}

function get_jobs() {
  local ram_gb=$(awk '/MemTotal/ { printf "%d", $2 / 1024 / 1024 }' /proc/meminfo)
  # 16GbB ram = 1 job
  local jobs=$((ram_gb / 16))
  echo "$((jobs>0 ? jobs : 1))"
}

current_host=$(hostname)
if [[ -z "$host" ]]; then
  host="$current_host"
fi

function nixos_rebuild() {
  local command="$1"
  local COMMAND_ARGS="--max-jobs $(get_jobs) --cores $(get_cores) --accept-flake-config --flake .#${host} ${EXTRA_HOST_ARGS[$host]}"
  echo "Running nixos-rebuild test for ${host}"
  if [[ $host == $current_host ]]; then
    command_log "/run/wrappers/bin/sudo -n /run/current-system/sw/bin/nixos-rebuild $command ${COMMAND_ARGS}"
    /run/wrappers/bin/sudo -n \
      /run/current-system/sw/bin/nixos-rebuild $command ${COMMAND_ARGS}
  else
    command_log "NIX_SSHOPTS='-i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes\" /run/current-system/sw/bin/nixos-rebuild $command ${COMMAND_ARGS}"
    NIX_SSHOPTS='-i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes' \
    /run/current-system/sw/bin/nixos-rebuild $command ${COMMAND_ARGS}
  fi
}

function update() {
  echo "Updating flake inputs..."
  nix flake update
  nixos_rebuild "switch"
}

function hardware() {
  sudo nixos-generate-config --dir ./hosts/$host
}

function clean_garbage() {
  echo "Cleaning up old generations and garbage..."
  sudo nix-collect-garbage -d
}

function clean_store() {
  echo "Cleaning up Nix store..."
  sudo nix-store --gc  
}


case $command in
  switch)
    nixos_rebuild switch
    ;;
  test)
    nixos_rebuild test
    ;;
  update)
    update
    ;;
  hardware)
    hardware
    ;;
  clean-garbage)
    clean_garbage
    ;;
  clean-store)
    clean_store
    ;;
  clean)
    clean_garbage
    clean_store
    ;;
  *)
    echo "Unknown command: $command"
    help
    exit 1
    ;;
esac